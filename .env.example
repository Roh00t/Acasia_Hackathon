ANTHROPIC_API_KEY=
# Optional for local development; Vercel requires a persistent PostgreSQL DATABASE_URL.
DATABASE_URL=
# Agent model. The team runs Opus 5.5 (~$0.05 per negotiation); Haiku 5.5 is ~$0.0013.
ATM_MODEL=claude-opus-5-5
# Secret for the HMAC-keyed consensus log. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty and the log falls back to unkeyed SHA-256 (the console says which).
ATM_LOG_KEY=
# Vercel only: set to 1 to let visitors of the public site start live (paid) Claude runs.
# Unset, the deployed console runs the offline rule agents. Local runs ignore this.
ATM_ALLOW_LIVE=
