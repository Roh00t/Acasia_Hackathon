ANTHROPIC_API_KEY=
# Agent model. The team runs Opus 5.5 (~$0.05 per negotiation); Haiku 5.5 is ~$0.0013.
ATM_MODEL=claude-opus-5-5
# Secret for the HMAC-keyed consensus log. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty and the log falls back to unkeyed SHA-256 (the console says which).
ATM_LOG_KEY=
